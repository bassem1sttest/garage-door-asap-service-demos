{
  "name": "garage-door-asap-demos",
  "version": "1.0.0",
  "description": "Two homepage redesign demos for Garage Door ASAP Service (Tailwind CSS v4)",
  "scripts": {
    "build:1": "tailwindcss -i demo-1-night-shift/src/input.css -o demo-1-night-shift/styles.css --minify",
    "build:2": "tailwindcss -i demo-2-daylight/src/input.css -o demo-2-daylight/styles.css --minify",
    "build": "npm run build:1 && npm run build:2",
    "dev:1": "tailwindcss -i demo-1-night-shift/src/input.css -o demo-1-night-shift/styles.css --watch",
    "dev:2": "tailwindcss -i demo-2-daylight/src/input.css -o demo-2-daylight/styles.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
